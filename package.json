{
  "name": "teaching-assistant-app",
  "version": "1.0.0",
  "description": "Teaching assistant: a full-stack TypeScript example (React client, Express server) for the Software Engineering course",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix server",
    "client": "npm start --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm test --prefix server",
    "test:client": "CI=true npm test --prefix client",
    "test:cucumber": "npm run test:cucumber --prefix client",
    "test:correlation-api": "npm run test:cucumber --prefix client -- --profile correlation-api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cucumber-html-reporter": "^7.2.0",
    "cucumber-pretty": "^6.0.1",
    "cypress": "^16.3.0",
    "cypress-cucumber-preprocessor": "^4.3.1",
    "cypress-xpath": "^2.0.1"
  },
  "keywords": [
    "react",
    "nodejs",
    "typescript",
    "express",
    "student-management",
    "fullstack"
  ],
  "author": "Paulo",
  "license": "ISC",
  "workspaces": [
    "client",
    "server"
  ],
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
